[core]
	hooksPath = C:/Program Files/Git/mingw64/share/git-core/templates/hooks
[user]
	name = brantley.blanchard
[advice]
	skippedCherryPicks = false
[grep]
	patternType = perl
[color]
	ui = true
[pull]
	rebase = true
[push]
	default = simple
[diff]
	tool = bc
[difftool]
	prompt = true
[difftool "bc"]
	path = c:/Program Files/Beyond Compare 5/bcomp.exe
[merge]
	tool = bc
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "bc"]
	path = c:/Program Files/Beyond Compare 5/bcomp.exe
[alias]
	all = "!f() { cd \"${GIT_PREFIX:-.}\" || return 1; for d in */.git; do [ -e \"$d\" ] || continue; r=${d%/.git}; { git -C \"$r\" \"$@\" >/dev/null 2>&1 && echo \"$r\" || git echo \"$r\"; } & done; wait; }; f"
	cached = difftool --dir-diff --cached
	review = "!sha=$1; git info; b() { if git diff --quiet; then git difftool --dir-diff --cached; else git difftool --dir-diff; fi; }; s() { git difftool --dir-diff \"$sha^\" \"$sha\"; }; r() { if [ -z \"$sha\" ]; then b; else s; fi; }; r"
	jira = "!f() { git log --oneline --reverse --pretty=\"%ad %C(yellow)%h %C(red)%an %C(reset)%s\" --perl-regexp -i --date=short --grep=\"$1\" --author=\"^((?!(unknown|BuildSvcUser)).*)$\"; }; f"
	lol = log --oneline --graph --decorate --pretty=format:\"%ad %C(yellow)%h %C(green)%cn: %C(red)%d %Creset%s\" --date=short
	info = "!sha=$1; i() { git echo 'Branches' && git branch && echo && git echo 'Revisions' && git lol -8 && echo && git echo 'Edits' && git status; }; f() { git show --name-only $sha; }; r() { if [ -z \"$sha\" ]; then i; else f; fi; }; r"
	branch-name = "!f() { git rev-parse --abbrev-ref HEAD 2>/dev/null; }; f"
	alias = "!f() { git config --list | grep ^alias.$1; }; f"
	echo = "!f() { tput setaf 1 && echo $1 && tput sgr0; }; f"
	rmbr = "!f() { b=${1:-$(git branch-name)}; case \"$b\" in ''|HEAD|main|master|develop|staging) git echo \"Refusing to delete remote branch: '$b'\"; return 1;; esac; git info; git push origin --delete \"$b\" && git fetch --prune; }; f"
	mkbr = push -u origin HEAD
	cp = cherry-pick
